# Block by Block: local secrets. TEMPLATE: copy to `env` (gitignored) and fill in the password.
#
# How to connect to our Postgres
#   1. Fill in the values below (ask the team for the password; it is never in git).
#   2. Python:      pip install "psycopg[binary]"
#                   psycopg.connect(host=..., port=..., dbname=..., user=..., password=..., sslmode=...)
#   3. psql:        psql "host=$POSTGRES_HOST port=$POSTGRES_PORT dbname=$POSTGRES_DB user=$POSTGRES_USER sslmode=$POSTGRES_SSLMODE"
#   4. Next.js:     DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DB (set it in Vercel env vars, not here)
#   5. Databricks:  python databricks/setup/setup_postgres.py
#                   copies these values into the `bbb` secret scope and creates the Unity Catalog
#                   connection `bbb_pg` and foreign catalog `bbb_app` (see plan.md section 5.1).
#
# NOTE (2026-11-07): the server currently rejects SSL ("server does not support SSL"), so
# sslmode=require fails. Turn on SSL on the server before Databricks connects over the internet.

# PostgreSQL connection settings
POSTGRES_HOST=db-hackcamp.noodlelab.ca
POSTGRES_PORT=5433
POSTGRES_DB=hackcamp
POSTGRES_USER=hackcamp
POSTGRES_PASSWORD=<ask-the-team>

# Set to require for hosted PostgreSQL, or disable for a local database.
POSTGRES_SSLMODE=require

# Auth0 API verification (public configuration; no client secret is needed).
# Example issuer: https://your-tenant.us.auth0.com/ (must match the token's issuer).
AUTH0_ISSUER=
AUTH0_AUDIENCE=https://api.blockbyblock
