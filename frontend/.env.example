# Copy this file to .env to change it. Never commit .env.
# true (default) = use the sample data in src/data/mockData.ts and src/data/mockComments.ts
# false = call the real backend
VITE_USE_MOCK=true
# Where the backend lives. During dev, /api is forwarded to http://localhost:8000 (see vite.config.ts).
VITE_API_BASE=/api
# Auth0 sign-in, only used when VITE_USE_MOCK=false. Public values from the Auth0 dashboard
# (Applications > blockbyblock-web). The audience must match AUTH0_AUDIENCE in the repo-root .env.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://api.blockbyblock
