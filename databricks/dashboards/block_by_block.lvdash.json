{
  "datasets": [
    {
      "name": "ds1",
      "displayName": "Track 1: where neighbours can help, by area",
      "queryLines": [
        "SELECT local_area, count(*) AS hotspots, sum(times_reported) AS reports\n",
        "FROM bbb.gold.help_hotspots\n",
        "WHERE local_area IS NOT NULL\n",
        "GROUP BY local_area\n",
        "ORDER BY hotspots DESC"
      ]
    },
    {
      "name": "ds2",
      "displayName": "Track 2: most pressing City-only issues",
      "queryLines": [
        "SELECT local_area, request_type, address, open_cases, days_open, times_reported_12m, round(base_score, 1) AS score\n",
        "FROM bbb.gold.track2_issues\n",
        "ORDER BY base_score DESC\n",
        "LIMIT 25"
      ]
    },
    {
      "name": "ds3",
      "displayName": "Cases opened per week, by track, last 12 months",
      "queryLines": [
        "SELECT date_trunc('week', opened_at) AS week, track, count(*) AS cases\n",
        "FROM bbb.gold.cases_enriched\n",
        "WHERE opened_at >= current_date() - INTERVAL 12 MONTHS AND track IN ('neighbours', 'city')\n",
        "GROUP BY ALL\n",
        "ORDER BY week"
      ]
    },
    {
      "name": "ds4",
      "displayName": "How fast the City closes cases, by category",
      "queryLines": [
        "SELECT category, percentile_approx(resolution_days, 0.5) AS median_days, count(*) AS closed_cases\n",
        "FROM bbb.gold.cases_enriched\n",
        "WHERE closed_on IS NOT NULL AND resolution_days >= 0 AND opened_at >= current_date() - INTERVAL 12 MONTHS\n",
        "GROUP BY category\n",
        "ORDER BY median_days DESC"
      ]
    },
    {
      "name": "ds5",
      "displayName": "Open issues in the last 90 days, as points",
      "queryLines": [
        "SELECT latitude, longitude, track, category, request_type\n",
        "FROM bbb.gold.cases_enriched\n",
        "WHERE status = 'Open' AND track IN ('neighbours', 'city') AND latitude IS NOT NULL\n",
        "  AND opened_at >= current_date() - INTERVAL 90 DAYS"
      ]
    },
    {
      "name": "ds6",
      "displayName": "AI sorting: how many request types landed in each category and track",
      "queryLines": [
        "SELECT t.category, coalesce(o.track, t.ai_track) AS track, count(*) AS request_types\n",
        "FROM bbb.gold.type_categories t\n",
        "LEFT JOIN bbb.gold.track_overrides o USING (request_type)\n",
        "GROUP BY ALL\n",
        "ORDER BY request_types DESC"
      ]
    }
  ],
